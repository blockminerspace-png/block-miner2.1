# ⚠️ PRODUCTION CONFIG - Nunca commitar .env com dados sensíveis!

# Blockchain
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_TIMEOUT_MS=4500
POLYGON_CHAIN_ID=137

# Etherscan API V2 (verificação de TXs do check-in — suporta Polygon via chainid=137)
# Create at https://etherscan.io/apidashboard (API v2; Polygon uses chainid=137 in code)
POLYGONSCAN_API_KEY=sua_api_key_aqui

# Hot Wallet (para saques de cripto)
# Use uma wallet com saldo limitado, nunca a principal!
WITHDRAWAL_PRIVATE_KEY=seu_private_key_aqui
WITHDRAWAL_MNEMONIC=

# POL deposits (on-chain verification — same vars as server + client build)
MIN_DEPOSIT_AMOUNT=0.01
BLOCK_CONFIRMATIONS=3
# Public treasury address users send POL to (must match on-chain verification)
DEPOSIT_WALLET_ADDRESS=0xYourTreasuryPolygonAddress

# Optional: BlockMinerDeposit.sol on Polygon — when set, UI prefers contract deposits and sync polls DepositReceived logs
SMART_CONTRACT_ADDRESS=

# WalletConnect — keep in server .env.production (docker build + runtime: Node injects into index.html if build missed VITE_*).
# Without VITE_WALLETCONNECT_PROJECT_ID the SPA has no project id → mobile Chrome cannot use WalletConnect.
# VITE_PUBLIC_WALLET_APP_URL must match the live site (and your WalletConnect Cloud allowed domain).
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_cloud_project_id
VITE_PUBLIC_WALLET_APP_URL=https://blockminer.space
# VITE_POLYGON_RPC_URL=https://polygon-rpc.com

# Cloudflare Turnstile (login/register + other routes when secrets are set).
# Dashboard: https://dash.cloudflare.com/ → Turnstile → add hostnames (tests.blockminer.space, blockminer.space, …).
# Site keys are public (VITE_*); secrets stay server-side only. VITE_* are baked in at `docker compose build app`.
# VITE_TURNSTILE_SITE_KEY_LOGIN=paste_turnstile_site_key
# VITE_TURNSTILE_SITE_KEY_REGISTER=paste_turnstile_site_key_optional
# TURNSTILE_SECRET_KEY_LOGIN=paste_turnstile_secret_key
# TURNSTILE_SECRET_KEY_REGISTER=paste_turnstile_secret_key_optional
# TURNSTILE_SECRET_KEY=paste_secret_for_non_auth_routes_optional
# Remove dummy mode to drop the pink "Somente para teste" banner (use real keys above):
# TURNSTILE_USE_CLOUDFLARE_DUMMY_KEYS=
# VITE_TURNSTILE_DUMMY_FALLBACK=
# Emergency only (server refuses NODE_ENV=production + dummy unless this is set):
# ALLOW_TURNSTILE_DUMMY_IN_PRODUCTION=

# Behind nginx: use real client IP when needed
TRUST_PROXY=1

# Deposits/Check-in: CHECKIN_RECEIVER overrides; if empty/zero, server uses DEPOSIT_WALLET_ADDRESS for paid check-in.
CHECKIN_RECEIVER=0x...seu_endereco...
CHECKIN_AMOUNT_WEI=10000000000000000

# JWT (Gerado aleatoriamente, mínimo 32 caracteres)
# Linux: openssl rand -hex 64
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres
JWT_ISSUER=blockminer
JWT_AUDIENCE=blockminer.app
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL_DAYS=30

# App config
ONLINE_START_DATE=2026-02-13
MEMORY_GAME_REWARD_GH=5
NODE_ENV=production
PORT=3000

# Database
DB_PATH=/app/data/blockminer.db

# Backup (diário local + replicação externa opcional)
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_RUN_ON_STARTUP=true
BACKUP_STARTUP_DELAY_MS=60000
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=7
BACKUP_FILENAME_PREFIX=blockminer-db-

# Externo (NAS/disco secundário)
BACKUP_EXTERNAL_ENABLED=true
BACKUP_EXTERNAL_DIR=/mnt/external-backups/blockminer
BACKUP_EXTERNAL_RETENTION_DAYS=30

# Google Drive (via rclone)
# Exige: rclone instalado e remoto "gdrive" configurado no servidor
BACKUP_CLOUD_ENABLED=true
BACKUP_CLOUD_COMMAND=rclone copy "{backupFile}" "gdrive:blockminer-backups" --transfers 1 --checkers 1 --drive-chunk-size 32M --fast-list
BACKUP_CLOUD_TIMEOUT_MS=120000

# Backup completo do site ao iniciar (DB + código fonte)
BACKUP_FULL_SITE_ON_STARTUP=true
BACKUP_FULL_SITE_STARTUP_DELAY_MS=15000

# CORS - Seus dominios
CORS_ORIGINS=https://seu-dominio.com,https://admin.seu-dominio.com

# Opcional: Error tracking (Sentry)
# SENTRY_DSN=

# Opcional: Email (para notificações)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

