    // 3. Fallback: Use a simple external lookup API
    if (!empty($ip)) {
        $apiUrl = "https://ipapi.co/{$ip}/country/";
        $country = @file_get_contents($apiUrl);
        if ($country && preg_match('/^[A-Z]{2}$/', trim($country))) {
            return trim($country);
        }
