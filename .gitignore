# Env / secrets
# Guia local de deploy (pode conter notas sensíveis) — não commitar
deploy.md
# Ficheiro único de deploy (host/user/password) — ler deploy.secrets.example
deploy.secrets.local
# deploy.py na raiz é versionado (sem segredos); segredos só em deploy.secrets.local ou BLOCKMINER_VPS_PW
scripts/vm_config_secret.py
scripts/deploy_credentials.local.py
.deploy-pw.txt
deploy-credentials.local.md
.env
.env.local
.env.*.local
env_new.tmp
.env.production
.env.production.vm-backup
!.env.example
/secrets/

# BTCPay coexistence on same VPS (LE / self-signed; not committed)
nginx/certs-btcpay/*.pem
nginx/certs-btcpay/*.key
certbot-www/*
!certbot-www/.gitkeep

# SQLite / local data
data/*.db
data/*.db-journal
data/*.sqlite
data/*.sqlite3
data/*.db-shm
data/*.db-wal
data/*.sqlite-shm
data/*.sqlite-wal

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
# Universal agent skills installer (`npx skills add …`) clones upstream repos here — do not commit.
.agents/
# Same installer may leave a root symlink + lock file — do not commit.
/skills/
skills-lock.json

# Local venv for NotebookLM CLI (notebooklm-py); agent uses scripts/notebooklm-run.sh
.venv-notebooklm/
# pip --target install used by scripts/notebooklm-run.sh (do not commit ~21MB tree)
vendor-notebooklm/
.claude/
.cursor/
.opencode/
.openclaude-profile.json

# Certs / backups (never commit real TLS keys; pasta existe via .gitkeep)
nginx/certs/*.pem
nginx/certs/*.pfx
nginx/certs/*.key
backups/

/src/generated/prisma
