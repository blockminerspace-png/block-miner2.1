# Copia para deploy.secrets.local (na raiz do repo) e preenche.
# deploy.secrets.local está no .gitignore — NUNCA commites.

SSH_HOST=89.167.119.164
SSH_USER=root
SSH_PASSWORD=your_ssh_password_here

# --- VM de teste (exemplo — copia linhas para deploy.secrets.local e ajusta) ---
# SSH_HOST=89.167.114.67
# SSH_USER=root
# SSH_PASSWORD=your_test_root_password_here
# REMOTE_PATH=/root/block-miner-v3
# docker-compose.yml sets Compose project name "block-miner", so containers are always:
#   block-miner-app-1, block-miner-nginx-1, block-miner-db-1 (not tied to the folder name).
# Branch no remoto para git reset — produção deve seguir origin/main (default do script).
# Só defina outra branch se precisares de um fluxo antigo; para forçar main num deploy: $env:DEPLOY_GIT_BRANCH='main'
# DEPLOY_GIT_BRANCH=main
# Optional: host port for the app container (default 3000). Use on shared test VMs if 3000 is busy.
# APP_HOST_PORT=3001
# NGINX_PUBLISH_HTTP=8080
# NGINX_PUBLISH_HTTPS=8443
# Standard ports when this stack owns 80/443/3000 on the VM:
# APP_HOST_PORT=3000
# NGINX_PUBLISH_HTTP=80
# NGINX_PUBLISH_HTTPS=443
# Postgres on the host (default 5432). Override if another service already binds 5432:
# DB_PUBLISH_PORT=55432
# Alternative to SSH_PASSWORD above: put the same password in a single-line file `.deploy-pw.txt`
# at the repo root (gitignored). Useful when you do not want the password inside deploy.secrets.local.

REMOTE_PATH=/root/block-miner

# Opcional: quando o PuTTY diz "host key does not match", cola a linha "SHA256:..." que o plink mostra:
# SSH_HOSTKEY=SHA256:...

# Opcional: após git pull, copia certificados Let's Encrypt já emitidos na VM para nginx/certs
# (evita ERR_CERT_AUTHORITY_INVALID quando o reset traz PEM de desenvolvimento fora do repo).
# LE_SYNC_DOMAIN=tests.blockminer.space

# BTCPay edge (subdomínio na mesma VPS): emite LE para nginx/certs-btcpay/ — ver scripts/remote-btcpay-letsencrypt.ps1
# Opcional se não usares LETSENCRYPT_EMAIL em docker/btcpay/env na VM:
# BTCPAY_LE_EMAIL=you@example.com

# WalletConnect / Reown — obrigatório para o modal no telemóvel. O deploy faz MERGE disto no .env.production
# enviado à VPS (não precisa repetir no .env.production.vm-backup se estiver aqui).
# VITE_WALLETCONNECT_PROJECT_ID=seu_project_id_reown_cloud
# VITE_PUBLIC_WALLET_APP_URL=https://blockminer.space

# Falha o deploy se o ID acima faltar (útil em CI): DEPLOY_REQUIRE_WALLETCONNECT=1

# Admin panel (BlockMiner admin SPA): merged into VPS .env — must match login form email + code/password
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_SECURITY_CODE=your_strong_unique_code
# ADMIN_SESSION_COOKIE_SECURE=true
# JWT_SECRET is required to mint the admin session cookie (usually already in .env.production.vm-backup); set here to override.
# JWT_SECRET=

# Live streaming admin (RTMP destinations): 32-byte key as 64 hex chars — merge para .env na VPS (openssl rand -hex 32).
# STREAM_ENCRYPTION_KEY=
# STREAM_CAPTURE_DISABLED=0

# Optional: YouTube video ID for /liveserver embed (build-time Vite). If unset, uses VITE_YOUTUBE_URL ?v=... when present.
# VITE_LIVE_SERVER_YOUTUBE_ID=dQw4w9WgXcQ

# --- BTCPay (Bitcoin deposits → POL) — merged into the BlockMiner API .env on deploy ---
# Use the SAME hostname as in docker/btcpay/env → BTCPAY_HOST on the BTCPay VPS (certificate must match).
# Fill API key, store id, and webhook signing secret from your BTCPay UI (never commit real values to Git).
# BTCPAY_URL=https://btcpay.blockminer.space
# BTCPAY_API_KEY=
# BTCPAY_STORE_ID=
# BTCPAY_WEBHOOK_SECRET=
# Pause: 1/true/yes/on pauses BTCPay (wallet "Coming soon", no invoices). To re-enable: omit this line or set BTCPAY_COMING_SOON=0, then redeploy/restart the API.
# BTCPAY_COMING_SOON=1
# Optional: BTCPAY_INVOICE_PAYMENT_METHODS — omit/unset uses BTCPay store defaults; or BTC, BTC,BTC-LightningNetwork, STORE_DEFAULT
# Webhook URL to register in BTCPay: https://blockminer.space/api/payments/btcpay/webhook
# Full setup: docker/btcpay/GUIA-COMPLETO-PT.md — certificate errors: see section 11 there.

# Deploy: controla envio de .env.production para a VPS (vê scripts/deploy e documentação).
# Nunca enviar .env: DEPLOY_SKIP_ENV_UPLOAD=1

# Após o contentor subir: aplica migrações Prisma na base (check-in marcos, etc.). Usa 1 na primeira vez ou quando houver migrações novas.
# DEPLOY_PRISMA_MIGRATE_DEPLOY=1
# Se uma migração falhou (P3018) e corrigiste o SQL / base, marca como rolled-back uma vez e volta a correr deploy:
# DEPLOY_PRISMA_MIGRATE_RESOLVE_ROLLED_BACK=20260410000000_add_user_rooms_and_racks
# Ex.: após corrigir user_owned_machines (user_vault em falta), uma vez: 20260419100000_user_owned_machines
