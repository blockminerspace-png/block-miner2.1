# ============================================================================
# BLOCKMINER - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values below.
# NEVER commit .env to version control (it's in .gitignore)
# ============================================================================

# ============================================================================
# SECURITY (REQUIRED)
# ============================================================================

# ----------------------------------------------------------------------------
# DISTRIBUTED SECURITY (Postgres — no Redis required)
# ----------------------------------------------------------------------------
# Sliding rate limits, idempotency leases, and progressive login lockout use the
# callback_queue table + transaction advisory locks. Optional cleanup interval:
# SECURITY_ARTIFACT_CLEANUP_MS=3600000
# SECURITY_ARTIFACT_MAX_AGE_H=72
# Unit tests use in-memory stores unless:
# FORCE_PG_SECURITY_STORES=1

# Progressive login lockout (tiers: 5 failures -> 15 min, 10 -> 1 hour; per IP and per user)
# AUTH_LOCKOUT_MAX_ATTEMPTS and AUTH_LOCKOUT_DURATION_MS are legacy env names (ignored for tier math).

# Cloudflare Turnstile (optional). When TURNSTILE_SECRET_KEY is set, login/register/offerwall writes
# and critical purchase/vault routes require a valid token (body.cfTurnstileToken or X-Turnstile-Token).
# TURNSTILE_SECRET_KEY=
# If siteverify fails during infra outages, set to 1 to allow requests (use sparingly).
# TURNSTILE_FAIL_OPEN=0

# CSRF cookie SameSite override: lax | strict | none (default strict in production, lax in dev)
# CSRF_COOKIE_SAMESITE=strict

# Client: set in client/.env (or Docker build args) for login/register widgets.
# Shared key:
# VITE_TURNSTILE_SITE_KEY=
# Per-screen keys (override shared):
# VITE_TURNSTILE_SITE_KEY_LOGIN=
# VITE_TURNSTILE_SITE_KEY_REGISTER=

# Production HTTPS redirect + HSTS (see server/middleware/httpsEnforcement.js)
# FORCE_HTTPS=1
# HSTS_MAX_AGE_SECONDS=31536000
# HSTS_INCLUDE_SUBDOMAINS=1
# HSTS_PRELOAD=0

# JWT Secret for authentication tokens
# REQUIRED: Must be at least 32 characters (use: openssl rand -hex 64)
# If not set, the server will refuse to start
JWT_SECRET=

# JWT Token TTL (Time To Live)
ACCESS_TOKEN_TTL=12h
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=blockminer
JWT_AUDIENCE=blockminer.app

# ============================================================================
# CORS & DEPLOYMENT
# ============================================================================

# Allowed origins for CORS (comma-separated, exact match)
# REQUIRED in production — the server will not start without this when NODE_ENV=production
# Example: https://blockminer.space,https://www.blockminer.space
# Development: leave empty to allow any origin
CORS_ORIGINS=

# Trust first reverse-proxy hop for correct req.ip / rate limits (set to 1 behind Nginx)
# TRUST_PROXY=1

# Max JSON/urlencoded body size (default 1mb). Increase only if needed.
# JSON_BODY_LIMIT=1mb

# ============================================================================
# INTERNAL OFFERWALL (PTC iframes + admin-managed tasks)
# ============================================================================
# Feature flag: unset or any value except 0/false/off enables the feature.
# INTERNAL_OFFERWALL_ENABLED=1
# Iframe allowlist for internal offerwall is stored in the database (internal_offerwall_frame_hosts
# and hostnames derived from saved offer URLs). Built-in defaults remain in code.
# Delete STARTED internal-offerwall attempts older than this many seconds (default 86400 = 24h).
# INTERNAL_OFFERWALL_ABANDON_STARTED_AFTER_SEC=86400
# Dev-only: allow http:// iframe URLs for PTC (never enable in production).
# INTERNAL_OFFERWALL_ALLOW_HTTP_IFRAME=0
# Optional: HTTPS URL to POST JSON when an internal-offerwall attempt is completed (self-claim or admin approval).
# Body: { event, attemptId, userId, offerId, offerKind, completedAtIso }. Header X-BlockMiner-Signature: sha256=<hex> when secret is set.
# INTERNAL_OFFERWALL_WEBHOOK_URL=
# INTERNAL_OFFERWALL_WEBHOOK_SECRET=

# ============================================================================
# LIVE STREAMING (Admin → YouTube RTMP, Linux worker on API host)
# ============================================================================
# 32-byte key as 64 hex chars (openssl rand -hex 32). Required to store stream keys encrypted.
# Also add to deploy.secrets.local so Windows deploy merges it into .env.production on the VM.
# STREAM_ENCRYPTION_KEY=
# Optional: disable capture pipeline (admin start returns environment errors).
# STREAM_CAPTURE_DISABLED=0
# After deploy on Linux: install system packages ffmpeg + xvfb, then run:
#   npx playwright install chromium

# Node environment
NODE_ENV=production
PORT=3000

# ============================================================================
# STARTUP SAFETY (RECOMMENDED: keep false in production)
# ============================================================================

# If true, container startup runs:
# - prisma db push
# - node server/prisma/seed.js
# Keep FALSE in production unless you explicitly want schema/data bootstrap.
DB_BOOTSTRAP_ON_STARTUP=false

# If true, server startup runs one-time data migration scripts (shortlinks/powers/etc).
# Keep FALSE in production unless explicitly planned.
RUN_STARTUP_DATA_MIGRATIONS=false

# App URL (for OAuth callbacks, email links, etc)
# Production: https://blockminer.space
# Development: http://localhost:3000
APP_URL=https://blockminer.space

# Logging level (case-insensitive): ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# ============================================================================
# ADMIN USERS (REQUIRED for production)
# ============================================================================

# Comma-separated list of admin email addresses (used with user JWT + requireAdmin routes)
# Example: admin@example.com,super-admin@example.com
# Development: empty list denies access unless ALLOW_OPEN_ADMIN_USER_ROUTES=1 (explicit dev-only escape hatch)
ADMIN_EMAILS=admin@example.com

# Dev-only: if 1/true, any logged-in user passes requireAdmin (NEVER enable in production)
# ALLOW_OPEN_ADMIN_USER_ROUTES=

# Admin login credentials
# Email for admin login
ADMIN_EMAIL=admin@blockminer.com

# Security code for admin login (minimum 4 characters)
# IMPORTANT: Keep this secure and do not commit to version control
ADMIN_SECURITY_CODE=CHANGE_ME_STRONG_UNIQUE_CODE
#
# If ADMIN_EMAIL or ADMIN_SECURITY_CODE are empty, POST /api/admin/auth/login returns 503.
# Docker: after editing env on the host, reload variables with:
#   docker compose up -d --force-recreate --no-deps app

# Admin session cookie: Secure flag (optional). false = allow HTTP (e.g. direct IP:port).
# Omit = Secure only when the request is HTTPS (or X-Forwarded-Proto: https).
# ADMIN_SESSION_COOKIE_SECURE=false

# JWT expiration time for admin sessions
ADMIN_JWT_EXPIRES_IN=24h

# ============================================================================
# DATABASE
# ============================================================================

# SQLite database path (inside Docker at /app/data/blockminer.db)
# Leave empty to use default; will be set in docker-compose.yml
DB_PATH=/app/data/blockminer.db

# ============================================================================
# FAUCET (Postgres / Prisma — valores só na criação do miner; depois persistem no DB)
# ============================================================================
# Slug do registro em miners (padrão: faucet-micro-miner)
# FAUCET_MINER_SLUG=faucet-micro-miner
# FAUCET_MINER_NAME=Pulse Mini v1
# FAUCET_POWER=1
# FAUCET_BASE_HASH_RATE=1
# FAUCET_IMAGE_URL=/machines/reward2.png
# FAUCET_COOLDOWN_MS=3600000

# ============================================================================
# BACKUP (local + external)
# ============================================================================

# Enable/disable backup cron
BACKUP_ENABLED=true

# Daily backup schedule (03:00 server time)
BACKUP_CRON=0 3 * * *

# Run one backup on startup
BACKUP_RUN_ON_STARTUP=true
BACKUP_STARTUP_DELAY_MS=60000

# Local backup settings
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=7
BACKUP_FILENAME_PREFIX=blockminer-db-

# Admin panel → Backups: full PostgreSQL dumps use pg_dump (postgresql-client in Docker image).
# Set if pg_dump is not on PATH (e.g. custom install).
# PG_DUMP_PATH=/usr/bin/pg_dump

# External backup replication (optional)
# Example Windows path: D:\\blockminer-external-backups
# Example network path: \\NAS\\blockminer\\backups
BACKUP_EXTERNAL_ENABLED=false
BACKUP_EXTERNAL_DIR=
BACKUP_EXTERNAL_RETENTION_DAYS=30

# Cloud backup command (optional, e.g. Google Drive via rclone)
# Requires rclone configured previously (example remote: gdrive)
# Placeholders available: {backupFile} and {backupFilename}
BACKUP_CLOUD_ENABLED=false
BACKUP_CLOUD_COMMAND=rclone copy "{backupFile}" "gdrive:blockminer-backups" --transfers 1 --checkers 1 --drive-chunk-size 32M --fast-list
BACKUP_CLOUD_TIMEOUT_MS=120000

# Full site backup on startup (includes DB + all source files as tar.gz)
# Automatically uploaded to cloud if BACKUP_CLOUD_ENABLED=true
BACKUP_FULL_SITE_ON_STARTUP=true
BACKUP_FULL_SITE_STARTUP_DELAY_MS=15000

# ============================================================================
# BLOCKCHAIN (Polygon Mainnet)
# ============================================================================

# RPC URL for Polygon (mainnet)
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# RPC timeout (ms) for on-chain reads (failover will try next endpoint)
POLYGON_RPC_TIMEOUT_MS=4500

# Chain ID for Polygon mainnet
POLYGON_CHAIN_ID=137

# Etherscan API key (https://etherscan.io/apidashboard) — used by the deposit scanner (Polygon via v2 API).
# Optional alias: POLYGONSCAN_API_KEY (same value).
ETHERSCAN_API_KEY=

# Optional: dedicated JSON-RPC for check-in verification (e.g. Aether / Alchemy / Infura).
# If unset, POLYGON_RPC_URL is used.
# AETHER_RPC_URL=https://...

# Only needed if you run checkins via smart contract.
DEPOSIT_WALLET_ADDRESS=0xYourDepositAddressHereForPolygon

# Check-in: FREE (one tap per day) only when both CHECKIN_RECEIVER and DEPOSIT_WALLET_ADDRESS are empty or 0x0.
# If CHECKIN_RECEIVER is set (non-zero), it is the treasury. Otherwise DEPOSIT_WALLET_ADDRESS is used as fallback.
CHECKIN_RECEIVER=

# Amount (in Wei) to send per check-in
# Default: 10000000000000000 = 0.01 tokens
CHECKIN_AMOUNT_WEI=10000000000000000

# ============================================================================
# HOT WALLET (for withdrawals & transactions)
# ============================================================================

# Private key of the hot wallet (64 hex chars, no 0x prefix required)
# WARNING: This key will be used to sign transactions! Keep it secure.
WITHDRAWAL_PRIVATE_KEY=

# OR use mnemonic phrase (12-24 words, space-separated)
# If both are set, PRIVATE_KEY takes precedence
WITHDRAWAL_MNEMONIC=

# If true/1, cron sends on-chain POL for withdrawals already **approved** by admin (every 2 min).
# Default (unset/false): manual only — admin copies destination, sends from hot wallet, marks complete with txHash.
WITHDRAWAL_AUTO_SEND=false

# ============================================================================
# POL DEPOSITS (Polygon chain 137 — async verifier + optional WalletConnect UI)
# ============================================================================

MIN_DEPOSIT_AMOUNT=0.01
# Aliases (optional): DEPOSIT_MIN_AMOUNT, CONFIRMATION_BLOCKS
DEPOSIT_MIN_AMOUNT=0.01
BLOCK_CONFIRMATIONS=3
DEPOSIT_WALLET_ADDRESS=

# On-chain POL deposit contract (Polygon mainnet). When set, the wallet UI prefers contract deposits and the verifier accepts txs to this address.
SMART_CONTRACT_ADDRESS=

# Optional: start block for first log scan (default: latest − 5000). Idempotent by tx hash.
CONTRACT_DEPOSIT_SYNC_FROM_BLOCK=

# Optional WebSocket RPC for lower latency listeners (not required; HTTP polling is used today).
# POLYGON_WS_URL=wss://...

# Client (Vite) — set when building the SPA
# VITE_WALLETCONNECT_PROJECT_ID=
# VITE_POLYGON_RPC_URL=https://polygon-rpc.com

# ============================================================================
# BTCPAY SERVER (optional — Bitcoin / Lightning deposits → POL balance)
# ============================================================================
# Full BTCPay install (Bitcoin Core + NBXplorer + Postgres + Nginx) is NOT bundled
# inside the BlockMiner image. Use the official Docker stack from the repo:
#   docker/btcpay/install-btcpay.sh  +  docker/btcpay/env.example → env
# Portuguese step-by-step (Cloudflare subdomain, ports, this file vs BlockMiner secrets):
#   docker/btcpay/GUIA-COMPLETO-PT.md
# Short pointer: docker/btcpay/LEIAME-PT.txt — upstream https://docs.btcpayserver.org/Docker/
#
# Public HTTPS base URL of your BTCPay instance (no trailing slash required).
# MUST be the same hostname the BTCPay TLS certificate was issued for (e.g. btcpay.blockminer.space).
# BTCPAY_URL=https://btcpay.blockminer.space
# Greenfield API key (Store / Server → Access tokens). Needs permission to create and view invoices.
# BTCPAY_API_KEY=
# Store id from BTCPay (Settings → General → Store ID).
# BTCPAY_STORE_ID=
# Webhook signing secret from BTCPay (Store → Webhooks → your delivery → Signing secret).
# Webhook URL must be: https://YOUR_API_HOST/api/payments/btcpay/webhook
# Deliveries: at minimum "A payment has been settled" (InvoiceSettled) / invoice settled events.
# BTCPAY_WEBHOOK_SECRET=
# Pause switch: when set to 1/true/yes/on, wallet shows "Coming soon" and invoice API + webhook credit are off.
# To re-enable after a pause: remove this variable, or set BTCPAY_COMING_SOON=0 (any value other than those four keeps BTCPay on).
# BTCPAY_COMING_SOON=true
# Optional Greenfield checkout.paymentMethods override (comma-separated). When unset, BTCPay uses only methods enabled in the store (recommended).
# Set BTC,BTC-LightningNetwork if your store has both. Use BTC alone if Lightning is not installed.
# BTCPAY_INVOICE_PAYMENT_METHODS=BTC,BTC-LightningNetwork

# ============================================================================
# APP CONFIG
# ============================================================================

# Date when the app came online (YYYY-MM-DD format)
ONLINE_START_DATE=2026-02-13

# Reward (in GH/s) given for completing memory game
MEMORY_GAME_REWARD_GH=5

# Chain 2048 (/games/2048): reward H/s, win tile, minimum score to claim, cooldown between claims (ms), power duration (days).
# GAME2048_REWARD_HASHRATE=25
# GAME2048_WIN_TILE=2048
# GAME2048_MIN_SCORE=1000
# GAME2048_COOLDOWN_MS=180000
# GAME2048_POWER_DAYS=7
# If the user has not confirmed today's daily check-in (Brazil day), 2048 reward lasts this many hours instead of GAME2048_POWER_DAYS.
# GAME2048_POWER_HOURS_NO_CHECKIN=24
# GAME2048_TIME_LIMIT_SEC=180

# Memory game: ms both wrong cards stay fully open after flip settles, before flip-back (500–1500, default 800). Server adds ~320ms for open animation.
# MEMORY_MISMATCH_REVEAL_MS=800

# ============================================================================
# FRONTEND (Vite) — Docker build only
# ============================================================================
# Injected when running `docker compose build` (same folder as docker-compose.yml).
# Add these keys to a `.env` file next to docker-compose.yml, or export them before build.
# Local dev: use client/.env (see client/.env.example).

VITE_DISCORD_URL=
VITE_TELEGRAM_URL=
VITE_YOUTUBE_URL=
# Optional /liveserver embed (see client/.env.example)
# VITE_LIVE_SERVER_YOUTUBE_ID=

