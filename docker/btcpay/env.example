# === BTCPay host (VPS where you run install-btcpay.sh) — NOT the BlockMiner app .env ===
# Copy to "env":   cp env.example env
# Full guide (PT): docker/btcpay/GUIA-COMPLETO-PT.md
# Then on that Linux VPS as root:  bash docker/btcpay/install-btcpay.sh
#
# DNS: BTCPAY_HOST must already resolve (Cloudflare A → this server IP) before install.

# Public hostname for BTCPay (HTTPS). MUST match the URL you open in the browser and the Let's Encrypt CN/SAN.
# Example used by BlockMiner ops: btcpay.blockminer.space
BTCPAY_HOST=btcpay.blockminer.space

# Required for Let's Encrypt email notifications
LETSENCRYPT_EMAIL=you@example.com

# mainnet | testnet | regtest — testnet syncs faster for first tests
NBITCOIN_NETWORK=testnet

# First chain (usually btc)
BTCPAYGEN_CRYPTO1=btc

# nginx = automatic HTTPS on this host (ports 80/443 must reach the internet)
BTCPAYGEN_REVERSEPROXY=nginx

# Leave empty for Bitcoin on-chain only. Or: clightning | lnd (needs more disk/RAM)
BTCPAYGEN_LIGHTNING=

# Pruned node to save disk (recommended on small VPS). Remove for full node.
BTCPAYGEN_ADDITIONAL_FRAGMENTS=opt-save-storage-s

# Optional: false recommended unless you want BTCPay UI to manage host SSH keys
BTCPAY_ENABLE_SSH=false

# Where to clone upstream (default: ./btcpayserver-docker next to this file)
# BTCPAY_INSTALL_DIR=/opt/btcpayserver-docker

# Optional: pin git branch of https://github.com/btcpayserver/btcpayserver-docker
# BTCPAYGIT_BRANCH=master

# If BlockMiner already uses 80/443 on THIS same machine, install BTCPay on another
# VPS or set custom ports (see upstream README: REVERSEPROXY_HTTP_PORT / REVERSEPROXY_HTTPS_PORT).
