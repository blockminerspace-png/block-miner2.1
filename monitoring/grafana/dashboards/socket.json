{
  "uid": "bm-socket",
  "title": "BlockMiner — Socket.IO",
  "tags": ["blockminer", "socket"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Active connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(blockminer_socket_connections_active)", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Connects / Disconnects per s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum(rate(blockminer_socket_connects_total[5m]))", "legendFormat": "connects", "refId": "A" },
        { "expr": "sum(rate(blockminer_socket_disconnects_total[5m]))", "legendFormat": "disconnects", "refId": "B" }
      ]
    },
    {
      "id": 3,
      "title": "Messages/s (in/out)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "sum by (direction) (rate(blockminer_socket_messages_total[5m]))",
        "legendFormat": "{{direction}}",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "title": "Messages by event",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [{
        "expr": "topk(15, sum by (event) (rate(blockminer_socket_messages_total[5m])))",
        "legendFormat": "{{event}}",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "title": "Disconnect reasons",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [{
        "expr": "sum by (reason) (rate(blockminer_socket_disconnects_total[5m]))",
        "legendFormat": "{{reason}}",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "title": "Note: rooms / ping / pong",
      "type": "text",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 20 },
      "options": {
        "content": "Rooms, ping/pong e heartbeat são geridos pelo engine Socket.IO (env `SOCKET_PING_*`). Métricas granulares de rooms requerem instrumentação futura em `module_actions`."
      }
    }
  ]
}
