{
  "uid": "bm-database",
  "title": "BlockMiner — Banco & Filas",
  "tags": ["blockminer", "database"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Postgres up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "pg_up", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] } }
    },
    {
      "id": 2,
      "title": "Redis connected (app)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "blockminer_redis_connected", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Prisma queries/s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum(rate(blockminer_prisma_queries_total[5m]))", "legendFormat": "qps", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Prisma P95 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(blockminer_prisma_query_duration_ms_bucket[5m])) by (le))",
        "legendFormat": "p95",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "title": "Slow queries/s",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 12 },
      "targets": [{ "expr": "sum(rate(blockminer_prisma_slow_queries_total[5m]))", "refId": "A" }]
    },
    {
      "id": 6,
      "title": "BullMQ jobs",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 12 },
      "targets": [
        { "expr": "blockminer_bullmq_jobs_waiting", "legendFormat": "waiting", "refId": "A" },
        { "expr": "blockminer_bullmq_jobs_active", "legendFormat": "active", "refId": "B" },
        { "expr": "blockminer_bullmq_jobs_failed", "legendFormat": "failed", "refId": "C" }
      ]
    },
    {
      "id": 7,
      "title": "Redis memory (app gauge)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 12 },
      "targets": [{ "expr": "blockminer_redis_memory_bytes", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 8,
      "title": "PG connections",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "targets": [{ "expr": "pg_stat_activity_count", "legendFormat": "{{state}}", "refId": "A" }]
    }
  ]
}
