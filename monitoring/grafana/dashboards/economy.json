{
  "uid": "bm-economy",
  "title": "BlockMiner — Economia",
  "tags": ["blockminer", "economy"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Mining block number",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "blockminer_mining_block_number", "refId": "A" }]
    },
    {
      "id": 2,
      "title": "Active miners",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "blockminer_mining_active_miners", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Blocks settled rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(blockminer_mining_blocks_total[15m])", "legendFormat": "blocks", "refId": "A" }]
    },
    {
      "id": 4,
      "title": "Module actions (by module)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "sum by (module) (rate(blockminer_module_actions_total[5m]))",
        "legendFormat": "{{module}}",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "title": "Cron last run (age seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{
        "expr": "time() - blockminer_cron_last_run_unix",
        "legendFormat": "{{job}}",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "title": "Energy Tax — pagamentos e sweeps",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "rate(blockminer_module_actions_total{module=\"energy-tax\",action=\"paid\"}[15m]) * 60",
          "legendFormat": "pagamentos/min",
          "refId": "A"
        },
        {
          "expr": "rate(blockminer_module_actions_total{module=\"energy-tax\",action=\"sweep\"}[1h]) * 3600",
          "legendFormat": "sweeps/h",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Callbacks externos (Zerads + OfferwallMe)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(blockminer_module_actions_total{module=\"callback\",action=\"zerads\"}[15m]) * 60",
          "legendFormat": "zerads/min",
          "refId": "A"
        },
        {
          "expr": "rate(blockminer_module_actions_total{module=\"callback\",action=\"offerwallme\"}[15m]) * 60",
          "legendFormat": "offerwallme/min",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Ações de economia — todos os módulos",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{
        "expr": "sum by (module) (rate(blockminer_module_actions_total{module!~\"energy-tax|callback\"}[15m]))",
        "legendFormat": "{{module}}",
        "refId": "A"
      }]
    }
  ]
}
