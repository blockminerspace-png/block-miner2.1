}

/// Singleton (id = 1): Polygon wallet address for the public transparency portal + admin on-chain audit.
model TransparencyWalletSettings {
  id        Int      @id @default(1)
  address   String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("transparency_wallet_settings")
}

model TransparencyTrackedWallet {
  id              Int      @id @default(autoincrement())
  label           String
  address         String
  chain           String   @default("polygon")
  assetSymbol     String   @default("POL") @map("asset_symbol")
  explorerBaseUrl String?  @map("explorer_base_url")
  isActive        Boolean  @default(true) @map("is_active")
  isPublic        Boolean  @default(true) @map("is_public")
  includeInTotals Boolean  @default(true) @map("include_in_totals")
  displayMode     String   @default("total_received") @map("display_mode")
  sortOrder       Int      @default(0) @map("sort_order")
  liquidityPoolsBackfilledAt DateTime? @map("liquidity_pools_backfilled_at")
  /// When set, frontend shows this fixed USD value instead of the on-chain snapshot
  /// (DeBank/multi-chain detection is hidden). Used for off-chain investments
  /// (e.g. ASIC hardware, USD on exchange) that can't be auto-detected.
  manualUsdValue  Float?   @map("manual_usd_value")
  manualValueNote String?  @map("manual_value_note")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  snapshot        TransparencyWalletSnapshot?
  liquidityPools  TransparencyLiquidityPoolPosition[]

  @@unique([chain, address])
  @@index([isActive, sortOrder])
  @@map("transparency_tracked_wallets")
}

/// Multi-chain on-chain snapshot for a tracked wallet.
/// Populated by walletSnapshotCron every 30 min; served instantly to users.
model TransparencyWalletSnapshot {
  id        Int      @id @default(autoincrement())
  walletId  Int      @unique @map("wallet_id")
  totalUsd  Float?   @map("total_usd")
  valuePol  Float?   @map("value_pol")
  chains    Json
  tokens    Json
  nfts      Json
  fetchedAt DateTime @map("fetched_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  wallet    TransparencyTrackedWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("transparency_wallet_snapshots")
}

/// Historical liquidity pool positions discovered for a tracked wallet.
/// Active positions remain visible in the wallet today; legacy positions were
/// previously seen but no longer appear in the current on-chain snapshot.
model TransparencyLiquidityPoolPosition {
  id              Int      @id @default(autoincrement())
  walletId        Int      @map("wallet_id")
  chainId         Int      @map("chain_id")
  chainName       String   @map("chain_name")
  contractAddress String   @map("contract_address")
  tokenId         String   @map("token_id")
  poolLabel       String?  @map("pool_label")
  name            String?
  description     String?
  imageUrl        String?  @map("image_url")
  tokenUri        String?  @map("token_uri")
  explorerUrl     String   @map("explorer_url")
  openseaUrl      String   @map("opensea_url")
  liquidityUsd    Float?   @map("liquidity_usd")
  status          String   @default("active")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  closedAt        DateTime? @map("closed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  wallet          TransparencyTrackedWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, chainId, contractAddress, tokenId])
  @@index([walletId, status, chainId])
  @@index([status, updatedAt])
  @@map("transparency_liquidity_pool_positions")
}

