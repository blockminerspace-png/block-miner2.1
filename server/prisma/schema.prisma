// ─── PARTNER GAMES ──────────────────────────────────────────────────────────
//
// Curated external games we embed in /games via iframe. Admin manages the
// catalog (title, description, cover, iframe URL, fallback URL, affiliate
// link). The frame URL host must be on the CSP allowlist; we maintain that
// dynamically through the existing internal-offerwall iframe-host service.
//
/// External (partner) game shown alongside our own minigames in /games.
model PartnerGame {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  description   String?
  coverImageUrl String?  @map("cover_image_url")
  iframeUrl     String   @map("iframe_url")
  fallbackUrl   String?  @map("fallback_url")
  partnerUrl    String?  @map("partner_url") // affiliate / "Visit partner" link
  /// iframe = embed on /games/partner/:slug; external = open partner site in new tab
  launchMode    String   @default("iframe") @map("launch_mode")
  embedStatus   String?  @map("embed_status")
  embedBlockReason String? @map("embed_block_reason")
  embedProbe    Json?    @map("embed_probe")
  embedProbedAt DateTime? @map("embed_probed_at")
  isVisible     Boolean  @default(true) @map("is_visible")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  votes    PartnerGameVote[]
  sessions PartnerGameSession[]

  @@index([isVisible, sortOrder])
  @@map("partner_games")
}

/// Community vote on a partner game (1 = like, -1 = dislike, one row per user/game).
model PartnerGameVote {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  partnerGameId Int      @map("partner_game_id")
  value         Int
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerGame PartnerGame @relation(fields: [partnerGameId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerGameId])
  @@index([partnerGameId])
  @@map("partner_game_votes")
}

/// Play session for partner-game rewards (+5 H/s per active minute).
model PartnerGameSession {
  id              String    @id @default(uuid())
  userId          Int       @map("user_id")
  partnerGameId   Int       @map("partner_game_id")
  /// active | paused | ended
  status          String    @default("active")
  accumulatedMs   Int       @default(0) @map("accumulated_ms")
  rewardCycleMs   Int       @default(0) @map("reward_cycle_ms")
  totalHashGranted Float    @default(0) @map("total_hash_granted")
  grantsCount     Int       @default(0) @map("grants_count")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerGame PartnerGame @relation(fields: [partnerGameId], references: [id], onDelete: Cascade)
  events      PartnerGameSessionEvent[]

  @@index([userId, status])
  @@index([partnerGameId])
  @@index([lastHeartbeatAt])
  @@map("partner_game_sessions")
}

/// Analytics events for partner play sessions.
model PartnerGameSessionEvent {
  id            Int      @id @default(autoincrement())
  sessionId     String   @map("session_id")
  userId        Int      @map("user_id")
  partnerGameId Int      @map("partner_game_id")
  event         String
  meta          Json?
  createdAt     DateTime @default(now()) @map("created_at")

  session PartnerGameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([partnerGameId, createdAt])
  @@index([userId, createdAt])
  @@map("partner_game_session_events")
}

// ─── TOURNAMENTS ────────────────────────────────────────────────────────────

enum TournamentType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum TournamentMetric {
  HASHRATE
  BLOCKS_MINED
  CHECKINS
  TASKS_COMPLETED
  DEPOSITS_POL
  DEPOSITS_USD
  OFFERS_INTERNAL
  OFFERS_EXTERNAL
  OFFERS_ALL
  MINIGAME_WINS
}

enum TournamentStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum TournamentPrizeType {
  POL
  BLK
  MINING_BOOST
  MACHINE
}

model Tournament {
  id                 Int                @id @default(autoincrement())
  name               String
  description        String?
  type               TournamentType
  metric             TournamentMetric
  metricConfig       Json?              @map("metric_config")
  startsAt           DateTime           @map("starts_at")
  endsAt             DateTime           @map("ends_at")
  status             TournamentStatus   @default(SCHEDULED)
  recurring          Boolean            @default(false)
  scoresReconciledAt DateTime?          @map("scores_reconciled_at")
  version            Int                @default(0)
  prizes             TournamentPrize[]
  entries            TournamentEntry[]
  scoreContributions TournamentScoreContribution[]
  scoreDrifts        TournamentScoreDrift[]
  offerwallMigration TournamentOfferwallMigration?
  shadowValidationAlerts TournamentShadowValidationAlert[]
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt     @map("updated_at")

  @@index([status, startsAt])
  @@index([status, endsAt])
  @@index([status, metric])
  @@map("tournaments")
}

model TournamentPrize {
  id           Int                @id @default(autoincrement())
  tournamentId Int                @map("tournament_id")
  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  rankFrom     Int                @map("rank_from")
  rankTo       Int                @map("rank_to")
  prizeType    TournamentPrizeType @map("prize_type")
  polAmount    Decimal?           @map("pol_amount")  @db.Decimal(20, 8)
  blkAmount    Decimal?           @map("blk_amount")  @db.Decimal(20, 8)
  boostHashRate Float?            @map("boost_hash_rate")
  boostHours   Int?               @map("boost_hours")
  minerId      Int?               @map("miner_id")
  minerCount   Int                @default(1) @map("miner_count")

  miner Miner? @relation(fields: [minerId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@map("tournament_prizes")
}

model TournamentEntry {
  id                  Int        @id @default(autoincrement())
  tournamentId        Int        @map("tournament_id")
  tournament          Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId              Int        @map("user_id")
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  score               Float      @default(0)
  rank                Int?
  firstContributionAt DateTime?  @map("first_contribution_at")
  rewardGranted       Boolean    @default(false) @map("reward_granted")
  rewardGrantedAt     DateTime?  @map("reward_granted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt      @map("updated_at")

  @@unique([tournamentId, userId])
  @@index([tournamentId, score(sort: Desc)])
  @@index([userId])
  @@map("tournament_entries")
}

/// Normalized offerwall/PTC actions — single source for incremental tournament scoring.
model TournamentAction {
  id                 BigInt   @id @default(autoincrement())
  userId             Int      @map("user_id")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String
  actionCount        Int      @map("action_count")
  executedAtUTC      DateTime @map("executed_at_utc")
  sourceId           String   @map("source_id")
  tournamentEligible Boolean  @default(true) @map("tournament_eligible")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([provider, sourceId])
  @@index([userId, executedAtUTC])
  @@index([executedAtUTC])
  @@map("tournament_actions")
}

/// Detect-only drift records (offerwall Engine V2). Never used for auto-correction.
model TournamentScoreDrift {
  id                      BigInt     @id @default(autoincrement())
  tournamentId            Int        @map("tournament_id")
  tournament              Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId                  Int?       @map("user_id")
  actionTotal             Float?     @map("action_total")
  contributionTotal       Float?     @map("contribution_total")
  entryScore              Float?     @map("entry_score")
  deltaActionsContributions Float?   @map("delta_actions_contributions")
  deltaContributionsEntry   Float?     @map("delta_contributions_entry")
  detectedAt              DateTime   @default(now()) @map("detected_at")

  @@index([tournamentId, detectedAt])
  @@map("tournament_score_drifts")
}

/// Global offerwall Engine V2 migration state (not tournament metric_config).
model TournamentOfferwallMigrationGlobal {
  id                    Int       @id @default(1)
  globalBackfillAt      DateTime? @map("global_backfill_at")
  globalBackfillActions Int       @default(0) @map("global_backfill_actions")
  globalBackfillSkipped Int       @default(0) @map("global_backfill_skipped")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("tournament_offerwall_migration_global")
}

/// Per-tournament offerwall migration / seal / shadow validation control.
model TournamentOfferwallMigration {
  tournamentId           Int        @id @map("tournament_id")
  tournament             Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  status                 String     @default("pending")
  baselineChecksum       String?    @map("baseline_checksum")
  verifiedParticipants   Int?       @map("verified_participants")
  verifiedLeaderScore    Float?     @map("verified_leader_score")
  sealedAt               DateTime?  @map("sealed_at")
  shadowValidationEndsAt DateTime?  @map("shadow_validation_ends_at")
  lastShadowCheckAt      DateTime?  @map("last_shadow_check_at")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  @@map("tournament_offerwall_migrations")
}

/// Shadow validation: legacy batch vs ledger (detect-only, never mutates rankings).
model TournamentShadowValidationAlert {
  id           BigInt     @id @default(autoincrement())
  tournamentId Int        @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       Int        @map("user_id")
  legacyScore  Float      @map("legacy_score")
  ledgerScore  Float      @map("ledger_score")
  delta        Float
  detectedAt   DateTime   @default(now()) @map("detected_at")

  @@index([tournamentId, detectedAt])
  @@map("tournament_shadow_validation_alerts")
}

/// Append-only ledger of score deltas per tournament (audit + idempotent projection).
model TournamentScoreContribution {
  id           BigInt     @id @default(autoincrement())
  tournamentId Int        @map("tournament_id")
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       Int        @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType   String     @map("source_type")
  sourceId     String     @map("source_id")
  metricValue  Decimal    @map("metric_value") @db.Decimal(20, 8)
  eventAt      DateTime   @map("event_at")
  metadata     Json?
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([tournamentId, sourceType, sourceId])
  @@index([tournamentId, userId])
  @@index([tournamentId, eventAt])
  @@map("tournament_score_contributions")
}

/// Transactional outbox for tournament domain events (deposit confirmed → score projection).
model TournamentDomainOutbox {
  id          Int       @id @default(autoincrement())
  eventType   String    @map("event_type")
  payload     Json
  status      String    @default("pending")
  retryCount  Int       @default(0) @map("retry_count")
  nextRunAt   DateTime  @default(now()) @map("next_run_at")
  lastError   String?   @map("last_error")
  idempotencyKey String @unique @map("idempotency_key")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, nextRunAt])
  @@index([eventType])
  @@map("tournament_domain_outbox")
}

// ─── Burn events ─────────────────────────────────────────────────────────────

model BurnEvent {
  id                Int       @id @default(autoincrement())
  title             String
  description       String?
  imageUrl          String?   @map("image_url")
  requiredHashRate  Float     @map("required_hash_rate")
  rewardMinerId     Int       @map("reward_miner_id")
  claimLimitPerUser Int       @default(1) @map("claim_limit_per_user")
  stockTotal        Int?      @map("stock_total")
  stockClaimed      Int       @default(0) @map("stock_claimed")
  startsAt          DateTime? @map("starts_at")
  endsAt            DateTime? @map("ends_at")
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  rewardMiner Miner       @relation(fields: [rewardMinerId], references: [id], onDelete: Restrict)
  claims      BurnClaim[]

  @@index([isActive, deletedAt])
  @@map("burn_events")
}

model BurnClaim {
  id                Int       @id @default(autoincrement())
  eventId           Int       @map("event_id")
  userId            Int       @map("user_id")
  totalHashRate     Float     @map("total_hash_rate")
  burnedMachinesJson Json     @map("burned_machines_json")
  rewardMinerName   String    @map("reward_miner_name")
  rewardInboxId     Int?      @map("reward_inbox_id")
  claimedAt         DateTime  @default(now()) @map("claimed_at")

  event BurnEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, userId])
  @@index([userId])
  @@map("burn_claims")
}

model EnergyTaxCharge {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  /// 00:00 BRT (America/Sao_Paulo) do dia coberto por essa cobrança.
  periodDayStartsAt DateTime @map("period_day_starts_at")
  /// "daily" = pagamento manual (5%/7 = 0.7143%) | "auto" = cobrança do cron de segunda 21h BRT (15%/7 = 2.1429%)
  mode              String
  rewardsBase       Decimal  @db.Decimal(20, 8) @map("rewards_base")
  ratePercent       Decimal  @db.Decimal(6, 4) @map("rate_percent")
  amount            Decimal  @db.Decimal(20, 8)
  /// paid (debitado integral) | partial (debitou o que tinha) | skipped (saldo zero)
  status            String   @default("paid")
  notes             String?
  transactionId     Int?     @unique @map("transaction_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@unique([userId, periodDayStartsAt])
  @@index([userId, createdAt])
  @@map("energy_tax_charges")
}

model AdminUser {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  role           String    @default("admin")
  permissions    Json?
  isActive       Boolean   @default(true) @map("is_active")
  lastLoginAt    DateTime? @map("last_login_at")
  lastLoginIp    String?   @map("last_login_ip")
  lastLoginUa    String?   @map("last_login_ua")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")
  createdById    Int?      @map("created_by_id")
  updatedById    Int?      @map("updated_by_id")

  sessions       AdminSession[]
  auditLogs      AdminAuditLog[]
  passwordResets AdminPasswordReset[]

  @@map("admin_users")
}

model AdminSession {
  id             String    @id
  adminId        Int       @map("admin_id")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  country        String?
  city           String?
  expiresAt      DateTime  @map("expires_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  admin          AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AdminAuditLog {
  id          BigInt    @id @default(autoincrement())
  adminId     Int?      @map("admin_id")
  adminEmail  String?   @map("admin_email")
  sessionId   String?   @map("session_id")
  action      String
  module      String?
  resource    String?
  resourceId  String?   @map("resource_id")
  oldValue    Json?     @map("old_value")
  newValue    Json?     @map("new_value")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  success     Boolean   @default(true)
  errorMsg    String?   @map("error_msg")
  durationMs  Int?      @map("duration_ms")
  createdAt   DateTime  @default(now()) @map("created_at")

  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
  @@index([module])
  @@map("admin_audit_logs")
}

model AdminPasswordReset {
  id        Int       @id @default(autoincrement())
  adminId   Int       @map("admin_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_password_resets")
}
