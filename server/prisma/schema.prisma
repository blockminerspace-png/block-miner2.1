  enabled               Boolean  @default(false)
  privateAlertsEnabled  Boolean  @default(false) @map("private_alerts_enabled")
  privateBotToken       String?  @map("private_bot_token")
  privateChatId         String?  @map("private_chat_id")
  publicProofsEnabled   Boolean  @default(false) @map("public_proofs_enabled")
  publicBotToken        String?  @map("public_bot_token")
  publicChatId          String?  @map("public_chat_id")
  publicTopicId         String?  @map("public_topic_id")
  captureEnabled        Boolean  @default(true) @map("capture_enabled")
  browserExecutablePath String?  @map("browser_executable_path")
  polygonscanBaseUrl    String?  @map("polygonscan_base_url")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("withdrawal_telegram_settings")
}

model TelegramOutboxEvent {
  id                Int       @id @default(autoincrement())
  type              String
  status            String    @default("pending")
  transactionId     Int?      @map("transaction_id")
  userId            Int?      @map("user_id")
  txHash            String?   @map("tx_hash")
  amount            Decimal?  @db.Decimal(20, 8)
  currency          String    @default("POL")
  destinationWallet String?   @map("destination_wallet")
  usernameSnapshot  String?   @map("username_snapshot")
  payload           Json      @default("{}")
  attempts          Int       @default(0)
  lastError         String?   @map("last_error")
  nextRunAt         DateTime  @default(now()) @map("next_run_at")
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([transactionId, type])
  @@index([status, nextRunAt])
  @@index([type])
  @@index([transactionId])
  @@index([userId])
  @@index([createdAt])
  @@map("telegram_outbox_events")
}
