// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  username      String?  @unique
  email         String   @unique
  passwordHash  String   @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  lastLoginAt   DateTime? @map("last_login_at")
  ip            String?  @map("last_ip")
  registrationIp String?  @map("registration_ip")
  userAgent     String?  @map("user_agent")
  isBanned      Boolean  @default(false) @map("is_banned")
  refCode       String?  @unique @map("ref_code")
  referredBy    Int?     @map("referred_by")
  walletAddress String?  @map("wallet_address")

  // Balances
  polBalance    Decimal  @default(0) @map("pol_balance") @db.Decimal(20, 8)
  btcBalance    Decimal  @default(0) @map("btc_balance") @db.Decimal(20, 8)
  ethBalance    Decimal  @default(0) @map("eth_balance") @db.Decimal(20, 8)
  usdtBalance   Decimal  @default(0) @map("usdt_balance") @db.Decimal(20, 8)
  usdcBalance   Decimal  @default(0) @map("usdc_balance") @db.Decimal(20, 8)
  zerBalance    Decimal  @default(0) @map("zer_balance") @db.Decimal(20, 8)
  blkBalance    Decimal  @default(0) @map("blk_balance") @db.Decimal(20, 8)
  blkLocked     Decimal  @default(0) @map("blk_locked") @db.Decimal(20, 8)
  shibBalance   Decimal  @default(0) @map("shib_balance") @db.Decimal(30, 8)
  /** 100% hashrate: pol = blocos POL simulados | blk = pool BLK por tempo (exclusivo) */
  miningPayoutMode String @default("pol") @map("mining_payout_mode")
  /** Hashrate allocation between POL and SHIB mining pools in basis points (10000 = 100% POL → 0% SHIB; 0 = 0% POL → 100% SHIB). */
  miningAllocationPolBps Int @default(10000) @map("mining_allocation_pol_bps")

  // Session Tracking
  ytSecondsBalance Int     @default(0) @map("yt_seconds_balance")
  autoMiningSecondsBalance Int @default(0) @map("auto_mining_seconds_balance")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")

  // Relationships
  miners        UserMiner[]
  inventory     UserInventory[]
  ownedMachines UserOwnedMachine[]
  vault         UserVault[]
  transactions  Transaction[]
  payouts       Payout[]
  auditLogs     AuditLog[]
  ipLogs        UserIpLog[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  checkins           DailyCheckin[]
  periodicCheckins   PeriodicCheckin[]
  faucetClaims  FaucetClaim?
  faucetVisits  FaucetPartnerVisit[]
  dailyPowerBoosts DailyPowerBoost[]
  gamePowers    UserPowerGame[]
  ytPowers      YoutubeWatchPower[]
  ytHistory     YoutubeWatchHistory[]
  shortlinkPowers ShortlinkPower[]
  rackConfigs   RackConfig[]
  ptpAds        PtpAd[]
  ptpEarnings   PtpEarning[]
  ptpSessions   PtpSession[]
  chatMessages  ChatMessage[]
  sentPrivateMessages     PrivateMessage[] @relation("SentPrivateMessages")
  receivedPrivateMessages PrivateMessage[] @relation("ReceivedPrivateMessages")
  gpuAccess     AutoMiningGpu[]
  gpuLogs       AutoMiningGpuLog[]
  referrals     Referral[] @relation("UserToReferrer")
  referred      Referral[] @relation("UserToReferred")
  earnings      ReferralEarning[] @relation("UserToReferrerEarnings")
  referredEarnings ReferralEarning[] @relation("UserToReferredEarnings")
  miningLogs    MiningRewardsLog[]
  shortlinkComp ShortlinkCompletion?
  hasAdblock    Boolean  @default(false) @map("has_adblock")
  isCreator     Boolean  @default(false) @map("is_creator")
  emailTwoFactorEnabled Boolean @default(false) @map("email_two_factor_enabled")
  youtubeUrl    String?  @map("youtube_url")

  // Energy Tax Block
  energyBlocked     Boolean  @default(false) @map("energy_blocked")
  energyBlockedAt   DateTime? @map("energy_blocked_at")

  // Migration Meta & Historical Data
  oldId             Int?     @unique @map("old_id")
  oldLifetimeMined  Decimal? @default(0) @map("old_lifetime_mined") @db.Decimal(20, 8)
  totalWithdrawn    Decimal? @default(0) @map("total_withdrawn") @db.Decimal(20, 8)
  rigsCount         Int?     @default(0) @map("rigs_count")
  oldBaseHashRate   Float?   @default(0) @map("old_base_hash_rate")
  
  blockMinerRewards BlockMinerReward[]
  energyTaxCharges  EnergyTaxCharge[]
  notifications     Notification[]
  eventPurchases    EventPurchase[]
  supportMessages   SupportMessage[]
  supportReplies    SupportReply[]
  userRooms              UserRoom[]
  userRacks              UserRack[]
  broadcastViews         BroadcastMessageView[]
  blkRewardLogs          BlkRewardLog[]
  checkinStreakRewards   UserCheckinStreakReward[]
  readEarnRedemptions    ReadEarnRedemption[]
  autoMiningV2Sessions           AutoMiningV2Session[]
  autoMiningV2Grants             AutoMiningV2PowerGrant[]
  autoMiningV2BannerImpressions  AutoMiningV2BannerImpression[]
  ccpaymentDepositEvents         CcpaymentDepositEvent[]
  miniPassEnrollments            UserMiniPassEnrollment[]
  miniPassXpLedger               UserMiniPassXpLedger[]
  miniPassMissionProgress        UserMiniPassMissionProgress[]
  miniPassRewardClaims           UserMiniPassRewardClaim[]
  miniPassPurchases              UserMiniPassPurchase[]
  dailyTaskProgress              UserDailyTaskProgress[]
  internalOfferwallAttempts      InternalOfferwallAttempt[]
  game2048Sessions               Game2048Session[]
  polygonHdAddress               PolygonHdAddress?
  rewardInbox                    UserRewardInbox[]
  tournamentEntries              TournamentEntry[]
  tournamentScoreContributions   TournamentScoreContribution[]
  tournamentActions              TournamentAction[]
  burnClaims                     BurnClaim[]
  checkinStreakRecoveries         CheckinStreakRecovery[]
  zeradsCallbacks                ZeradsCallback[]
  offerwallMeCallbacks           OfferwallMeCallback[]
  youtuberProfile                YoutuberProfile?
  videoSubmissions               YoutubeVideoSubmission[]
  videoVotes                     YoutubeVideoVote[]
  partnerGameVotes               PartnerGameVote[]
  partnerGameSessions            PartnerGameSession[]
  gameCooldownStates             GameCooldownState[]
  gameSessionLogs                GameSessionLog[]

  // Traffic attribution (captured at registration)
  utmSource      String? @map("utm_source")
  utmMedium      String? @map("utm_medium")
  utmCampaign    String? @map("utm_campaign")
  referrerDomain String? @map("referrer_domain")

  @@index([registrationIp])
  @@index([ip])
  @@index([walletAddress])
  @@index([createdAt])
  @@index([lastLoginAt])
  @@map("users")
}

/// Lightweight page-view hit for traffic analytics (landing page + key entry points).
model PageView {
  id             Int      @id @default(autoincrement())
  path           String   @default("/")
  referrerDomain String?  @map("referrer_domain")
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([referrerDomain])
  @@index([utmSource])
  @@map("page_views")
}

model IpIntelligenceCache {
  id                          Int      @id @default(autoincrement())
  ip                          String   @unique
  ipVersion                   Int      @map("ip_version")
  reverseDns                  String?  @map("reverse_dns")
  reverseDnsForwardConfirmed  Boolean? @map("reverse_dns_forward_confirmed")
  asn                         Int?
  asnOrg                      String?  @map("asn_org")
  networkCidr                 String?  @map("network_cidr")
  providerLabel               String?  @map("provider_label")
  providerType                String   @default("unknown") @map("provider_type")
  confidence                  String   @default("low")
  source                      String?
  error                       String?
  proxyDetected               Boolean? @map("proxy_detected")
  proxyType                   String?  @map("proxy_type")
  proxyRiskScore              Int?     @map("proxy_risk_score")
  proxyProvider               String?  @map("proxy_provider")
  proxyLastSeenAt             DateTime? @map("proxy_last_seen_at")
  proxyCheckedAt              DateTime? @map("proxy_checked_at")
  proxyExpiresAt              DateTime? @map("proxy_expires_at")
  proxySource                 String?  @map("proxy_source")
  proxyError                  String?  @map("proxy_error")
  checkedAt                   DateTime @map("checked_at")
  expiresAt                   DateTime @map("expires_at")
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@index([ip])
  @@index([asn])
  @@index([providerType])
  @@index([proxyDetected])
  @@index([proxyCheckedAt])
  @@index([expiresAt])
  @@map("ip_intelligence_cache")
}

/// Configurable daily objectives (Brazil calendar day; see daily task period helper).
model DailyTaskDefinition {
  id                   Int       @id @default(autoincrement())
  slug                 String    @unique
  taskType             String    @map("task_type")
  resetCadence         String    @default("DAILY") @map("reset_cadence")
  targetValue          Decimal   @map("target_value") @db.Decimal(24, 8)
  translationKey       String    @map("translation_key")
  rewardKind           String    @map("reward_kind")
  rewardMinerId        Int?      @map("reward_miner_id")
  rewardEventMinerId   Int?      @map("reward_event_miner_id")
  rewardHashRate       Float?    @map("reward_hash_rate")
  rewardHashRateDays   Int?      @map("reward_hash_rate_days")
  rewardBlkAmount      Decimal?  @map("reward_blk_amount") @db.Decimal(20, 8)
  rewardPolAmount      Decimal?  @map("reward_pol_amount") @db.Decimal(20, 8)
  gameSlug                     String?  @map("game_slug")
  internalOfferwallOfferId     Int?     @map("internal_offerwall_offer_id")
  sortOrder                    Int      @default(0) @map("sort_order")
  isActive                     Boolean  @default(true) @map("is_active")
  validFrom                    DateTime? @map("valid_from")
  validUntil                   DateTime? @map("valid_until")
  createdAt                    DateTime @default(now()) @map("created_at")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  progress                 UserDailyTaskProgress[]
  dedupeTicks              UserDailyTaskDedupeTick[]
  internalOfferwallOffer   InternalOfferwallOffer? @relation(fields: [internalOfferwallOfferId], references: [id], onDelete: SetNull)

  rewardMiner      Miner?      @relation(fields: [rewardMinerId], references: [id], onDelete: SetNull)
  rewardEventMiner EventMiner? @relation(fields: [rewardEventMinerId], references: [id], onDelete: SetNull)

  @@map("daily_task_definitions")
}

/// Admin-defined internal monetization offers (PTC iframe or general tasks).
model InternalOfferwallOffer {
  id                 Int      @id @default(autoincrement())
  kind               String   @map("kind")
  title              String
  description        String?  @db.Text
  iframeUrl          String?  @map("iframe_url") @db.Text
  minViewSeconds     Int      @default(10) @map("min_view_seconds")
  rewardKind         String   @map("reward_kind")
  rewardBlkAmount    Decimal? @map("reward_blk_amount") @db.Decimal(20, 8)
  rewardPolAmount    Decimal? @map("reward_pol_amount") @db.Decimal(20, 8)
  rewardHashRate     Float?   @map("reward_hash_rate")
  rewardHashRateDays Int?     @map("reward_hash_rate_days")
  dailyLimitPerUser  Int      @default(3) @map("daily_limit_per_user")
  sortOrder          Int      @default(0) @map("sort_order")
  isActive           Boolean  @default(true) @map("is_active")
  completionMode     String   @map("completion_mode")
  taskMetadata       Json?    @map("task_metadata")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  attempts             InternalOfferwallAttempt[]
  dailyTaskDefinitions DailyTaskDefinition[]

  @@map("internal_offerwall_offers")
}

/// Hostnames allowed to load in iframes / CSP frame-src (admin + auto-registered from offer URLs).
model InternalOfferwallFrameHost {
  id        Int      @id @default(autoincrement())
  hostname  String   @unique @map("hostname") @db.VarChar(253)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("internal_offerwall_frame_hosts")
}

model InternalOfferwallAttempt {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  offerId          Int       @map("offer_id")
  periodKey        String    @map("period_key")
  status           String    @map("status")
  startedAt        DateTime  @map("started_at")
  partnerOpenedAt  DateTime? @map("partner_opened_at")
  submittedAt      DateTime? @map("submitted_at")
  completedAt      DateTime? @map("completed_at")
  rewardGrantedAt  DateTime? @map("reward_granted_at")
  auditSnapshot    String?   @map("audit_snapshot") @db.Text
  adminNote        String?   @map("admin_note") @db.Text

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer InternalOfferwallOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([userId, offerId, periodKey])
  @@index([offerId, status])
  @@map("internal_offerwall_attempts")
}

model UserDailyTaskProgress {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  taskDefinitionId Int       @map("task_definition_id")
  periodKey        String    @map("period_key")
  currentValue     Decimal   @default(0) @map("current_value") @db.Decimal(24, 8)
  completedAt      DateTime? @map("completed_at")
  rewardClaimedAt  DateTime? @map("reward_claimed_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task DailyTaskDefinition   @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)

  @@unique([userId, taskDefinitionId, periodKey])
  @@index([userId, periodKey])
  @@map("user_daily_task_progress")
}

model UserDailyTaskDedupeTick {
  id               Int      @id @default(autoincrement())
  taskDefinitionId Int      @map("task_definition_id")
  dedupeKey        String   @map("dedupe_key")
  createdAt        DateTime @default(now()) @map("created_at")

  task DailyTaskDefinition @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)

  @@unique([taskDefinitionId, dedupeKey])
  @@map("user_daily_task_dedupe_ticks")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  type      String   @default("info") // info, success, warning, reward
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model BroadcastMessage {
  id                  Int      @id @default(autoincrement())
  title               String
  content             String?
  imageUrl            String?  @map("image_url")
  isActive            Boolean  @default(false) @map("is_active")
  dismissDelaySeconds Int      @default(10) @map("dismiss_delay_seconds")
  /// Optional CTA: when set, the popup renders a primary action button.
  /// linkUrl can be internal ("/shop") or external ("https://…").
  linkUrl             String?  @map("link_url")
  linkLabel           String?  @map("link_label")
  linkNewTab          Boolean  @default(false) @map("link_new_tab")
  createdAt           DateTime @default(now()) @map("created_at")

  views BroadcastMessageView[]

  @@map("broadcast_messages")
}

model BroadcastMessageView {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  messageId Int      @map("message_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  message BroadcastMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@map("broadcast_message_views")
}

model Session {
  token     String   @id
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenId    String    @unique @map("token_id")
  tokenHash  String    @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Miner {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  longDescription String? @map("long_description") @db.Text
  baseHashRate Float    @default(0) @map("base_hash_rate")
  price        Decimal  @default(0.5) @db.Decimal(20, 8)
  slotSize     Int      @default(1) @map("slot_size")
  imageUrl     String?  @map("image_url")
  tier         String   @default("common")
  sourceType   String   @default("store") @map("source_type")
  isActive     Boolean  @default(true) @map("is_active")
  showInShop   Boolean  @default(true) @map("show_in_shop")
  isArchived   Boolean  @default(false) @map("is_archived")
  sortOrder    Int      @default(0) @map("sort_order")
  maxPerUser   Int?     @map("max_per_user")
  stockTotal   Int?     @map("stock_total")
  stockSold    Int      @default(0) @map("stock_sold")
  availableFrom DateTime? @map("available_from")
  availableUntil DateTime? @map("available_until")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  userMiners        UserMiner[]
  userInventory     UserInventory[]
  userOwnedMachines UserOwnedMachine[]
  userVault         UserVault[]
  readEarnCampaigns ReadEarnCampaign[]
  faucetReward  FaucetReward?
  shortlinkRew  ShortlinkReward?
  miniPassLevelRewards MiniPassLevelReward[]
  dailyTaskRewardDefs DailyTaskDefinition[]
  checkinStreakMilestones CheckinStreakMilestone[]
  videoSubmissionRewards  YoutubeVideoSubmission[]
  youtuberRewardSettings  YoutuberRewardSettings[]
  tournamentPrizes       TournamentPrize[]
  burnEvents             BurnEvent[]

  @@index([isActive, showInShop])
  @@index([isArchived])
  @@index([tier])
  @@index([sourceType])
  @@index([price])
  @@index([baseHashRate])
  @@index([createdAt])
  @@map("miners")
}

model UserIpLog {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip                String
  deviceFingerprint String   @default("unknown") @map("device_fingerprint")
  networkCidr       String?  @map("network_cidr")
  asn               Int?
  providerType      String   @default("unknown") @map("provider_type")
  firstSeen         DateTime @default(now()) @map("first_seen")
  lastSeen          DateTime @default(now()) @map("last_seen")
  loginCount        Int      @default(0) @map("login_count")
  registerCount     Int      @default(0) @map("register_count")
  lastUserAgent     String?  @map("last_user_agent")

  @@unique([userId, ip, deviceFingerprint])
  @@index([ip])
  @@index([networkCidr])
  @@index([asn])
  @@index([providerType])
  @@index([deviceFingerprint])
  @@index([lastSeen])
  @@map("ip_logs")
}

model UserMiner {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  minerId     Int?     @map("miner_id")
  slotIndex   Int      @map("slot_index")
  level       Int      @default(1)
  hashRate    Float    @default(0) @map("hash_rate")
  slotSize    Int      @default(1) @map("slot_size")
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  purchasedAt DateTime @default(now()) @map("purchased_at")
  ownedMachineId Int?  @unique @map("owned_machine_id")

  user         User             @relation(fields: [userId], references: [id])
  miner        Miner?           @relation(fields: [minerId], references: [id])
  ownedMachine UserOwnedMachine? @relation(fields: [ownedMachineId], references: [id], onDelete: Restrict)
  userRack     UserRack?

  @@unique([userId, slotIndex])
  @@index([userId])
  @@map("user_miners")
}

model UserInventory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  minerId    Int?     @map("miner_id")
  minerName  String   @map("miner_name")
  level      Int      @default(1)
  hashRate   Float    @default(0) @map("hash_rate")
  slotSize   Int      @default(1) @map("slot_size")
  imageUrl   String?  @map("image_url")
  acquiredAt DateTime @default(now()) @map("acquired_at")
  expiresAt  DateTime? @map("expires_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  ownedMachineId Int? @unique @map("owned_machine_id")

  user         User             @relation(fields: [userId], references: [id])
  miner        Miner?           @relation(fields: [minerId], references: [id])
  ownedMachine UserOwnedMachine? @relation(fields: [ownedMachineId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_inventory")
}

model UserVault {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  minerId    Int?     @map("miner_id")
  minerName  String   @map("miner_name")
  level      Int      @default(1)
  hashRate   Float    @default(0) @map("hash_rate")
  slotSize   Int      @default(1) @map("slot_size")
  imageUrl   String?  @map("image_url")
  storedAt   DateTime @default(now()) @map("stored_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  ownedMachineId Int? @unique @map("owned_machine_id")

  user         User             @relation(fields: [userId], references: [id])
  miner        Miner?           @relation(fields: [minerId], references: [id])
  ownedMachine UserOwnedMachine? @relation(fields: [ownedMachineId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_vault")
}

/// Canonical owned machine instance: exactly one of inventory / rack miner / vault row points here.
enum MachineInstanceLocation {
  INVENTORY
  RACK
  WAREHOUSE
}

model UserOwnedMachine {
  id         Int                     @id @default(autoincrement())
  userId     Int                     @map("user_id")
  location   MachineInstanceLocation
  minerId    Int?                    @map("miner_id")
  minerName  String                  @map("miner_name")
  snapshotSlug String?                @map("snapshot_slug")
  level      Int                     @default(1)
  hashRate   Float                   @map("hash_rate")
  slotSize   Int                     @default(1) @map("slot_size")
  imageUrl   String?                 @map("image_url")
  snapshotPrice Decimal?              @map("snapshot_price") @db.Decimal(20, 8)
  acquisitionSource String?           @map("acquisition_source")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  miner          Miner?          @relation(fields: [minerId], references: [id], onDelete: SetNull)
  inventoryRow   UserInventory?
  rackMiner      UserMiner?
  vaultRow       UserVault?

  @@index([userId, location])
  @@index([minerId])
  @@map("user_owned_machines")
}

model Transaction {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  type            String    // deposit, withdrawal, etc
  amount          Decimal   @db.Decimal(20, 8)
  fee             Decimal?  @db.Decimal(20, 8)
  address         String?
  txHash          String?   @map("tx_hash")
  rawTx           String?   @map("raw_tx")
  txNonce         Int?      @map("tx_nonce")
  txGasPrice      String?   @map("tx_gas_price")
  txGasLimit      Int?      @map("tx_gas_limit")
  fromAddress     String?   @map("from_address")
  status          String    @default("pending")
  fundsReserved   Boolean   @default(false) @map("funds_reserved")
