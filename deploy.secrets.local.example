# Copy to `deploy.secrets.local` (gitignored) on the machine that runs deploy, OR add the same
# keys to the VPS `.env.production` / `.env.production.vm-backup` (restored across deploys).
#
# `docker compose` reads `.env.production` for build args + container env; `VITE_*` is baked
# into the client image at build time and also injected at runtime in `index.html` when set.

# Custodial Polygon HD deposit (BIP-44). Requires POLYGON_HD_MNEMONIC or PHD_SERVICE_URL+PHD_INTERNAL_TOKEN.
POLYGON_HD_DEPOSIT_ENABLED=1

# Reown / WalletConnect Cloud — public project id, exactly 32 hex characters.
# VITE_WALLETCONNECT_PROJECT_ID=
